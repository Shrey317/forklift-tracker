# --- Database (Section 29) ---
# Pooled connection — used for all runtime application queries.
# In Supabase, this is the pooler (pgbouncer) connection string.
DATABASE_URL="postgresql://app_runtime:CHANGE_ME@localhost:5432/forklift_tracker"

# Unpooled connection — used only for migrations (prisma.config.ts reads
# this one). Supabase's pooler doesn't support everything a migration
# needs. Locally, this can point at the same database as DATABASE_URL,
# just via a different (more privileged) role — see
# scripts/setup-local-db.sh.
DIRECT_URL="postgresql://forklift_migrator:CHANGE_ME@localhost:5432/forklift_tracker"

# --- App identity (Locked Decision #31, #36) ---
# The canonical production domain. Used for the CSRF origin check AND for
# QR-code generation — if this ever changes in production, existing QR
# labels stop resolving and need reprinting (Section 29).
APP_BASE_URL="http://localhost:3000"

# --- Seed credentials (Section 21) ---
# Read ONLY by `pnpm db:seed` (bootstrap, one-time, never in CI/CD) and
# `pnpm db:rotate-password` (rotation, reuses the same var name for the
# NEW password). 16+ characters, generated randomly — never a
# human-chosen password. NEVER commit real values here.
ADMIN_PASSWORD="CHANGE_ME_16_PLUS_RANDOM_CHARS"
SUPERVISOR_PASSWORD="CHANGE_ME_16_PLUS_RANDOM_CHARS"
FUEL_SUPERVISOR_PASSWORD="CHANGE_ME_16_PLUS_RANDOM_CHARS"

# --- Runtime ---
# Controls the session cookie's __Host- prefix and Secure flag (Section 21)
# — set automatically by `next build`/`next start`/hosting platforms in
# production. Only set this by hand for local development.
NODE_ENV="development"
