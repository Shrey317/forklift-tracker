generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  FUEL_SUPERVISOR
}

enum TrackingMode {
  MILEAGE
  ENGINE_HOURS
}

enum PowerSource {
  DIESEL
  LPG
  ELECTRIC
}

enum ForkliftStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
}

enum MaintenanceStatus {
  SCHEDULED
  COMPLETED
}

enum ShiftEndType {
  NORMAL
  FORCE_CLOSED
}

// Audit action vocabulary extended during Week 1 review: the original enum
// (per v3.3) was missing SHIFT_CREATED, SHIFT_ENDED, FUEL_LOG_CREATED, and
// FORKLIFT_ACTIVATED even though Section 11 gives Admin direct power to
// start/end shifts and add fuel records, and Locked Decision #18 says the
// log covers every Admin "create", not just edits/deletes. Every Admin
// mutation must map to exactly one of these.
enum AuditAction {
  FORKLIFT_CREATED
  FORKLIFT_EDITED
  FORKLIFT_STATUS_CHANGED
  FORKLIFT_ACTIVATED
  FORKLIFT_DEACTIVATED
  SHIFT_CREATED
  SHIFT_ENDED
  SHIFT_EDITED
  SHIFT_DELETED
  SHIFT_FORCE_CLOSED
  FUEL_LOG_CREATED
  FUEL_LOG_EDITED
  FUEL_LOG_DELETED
  MAINTENANCE_LOG_CREATED
  MAINTENANCE_LOG_EDITED
  MAINTENANCE_LOG_DELETED
}

enum AuditTargetType {
  FORKLIFT
  SHIFT
  FUEL_LOG
  MAINTENANCE_LOG
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  sessions            Session[]
  shiftsCreated       Shift[]          @relation("ShiftCreatedBy")
  shiftsEnded         Shift[]          @relation("ShiftEndedBy")
  fuelLogsCreated     FuelLog[]        @relation("FuelLogCreatedBy")
  maintenanceLogsMade MaintenanceLog[] @relation("MaintenanceLogCreatedBy")
  forkliftsCreated    Forklift[]       @relation("ForkliftCreatedBy")
  auditLogEntries     AuditLogEntry[]

  @@map("users")
}

// Database-backed session — Locked Decision #24, #26. The cookie holds a
// random raw token generated at login; only its SHA-256 hash is ever
// stored here, so reading this table alone doesn't hand out a working
// session.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Immutable safety audit log — Locked Decision #18. Every Admin mutation on
// a Forklift, Shift, FuelLog, or MaintenanceLog writes one row here, in the
// same transaction as the mutation itself (Section 27). No update or delete
// route is ever built for this table (MUST NOT #12) — and the application's
// own database role isn't granted UPDATE/DELETE on it either, so a bug
// can't do it by accident (see the audit-log-immutability migration).
model AuditLogEntry {
  id          String          @id @default(uuid())
  actorUserId String          @map("actor_user_id")
  actorUser   User            @relation(fields: [actorUserId], references: [id])
  actorRole   Role            @map("actor_role")
  action      AuditAction
  targetType  AuditTargetType @map("target_type")
  targetId    String          @map("target_id")
  beforeValue Json?           @map("before_value")
  afterValue  Json?           @map("after_value")
  reason      String?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log_entries")
}

// Historical login-attempt log, retained for security review — Locked
// Decision #35. Pruned automatically after 90 days; this is NOT what the
// rate limit itself checks against — see LoginThrottle below.
model LoginAttempt {
  id          String   @id @default(uuid())
  username    String
  ipAddress   String   @map("ip_address")
  succeeded   Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([username, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

// Atomic rate-limit counter — one row per throttled key. `key` is either
// `username:<username>` or `ip:<address>`, so one table serves both limits
// in Locked Decision #35. Updated via Postgres's native atomic upsert
// (INSERT ... ON CONFLICT DO UPDATE), never a count-then-decide read.
model LoginThrottle {
  key         String   @id
  failedCount Int      @default(0) @map("failed_count")
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("login_throttles")
}

model Forklift {
  id             String         @id @default(uuid())
  sequenceNumber Int            @default(autoincrement()) @map("sequence_number")
  displayId      String         @unique @map("display_id")
  name           String
  manufacturer   String
  model          String
  qrToken        String         @unique @map("qr_token")
  trackingMode   TrackingMode   @default(MILEAGE) @map("tracking_mode")
  powerSource    PowerSource    @default(DIESEL) @map("power_source")
  status         ForkliftStatus @default(ACTIVE)
  isActive       Boolean        @default(true) @map("is_active")
  createdById    String         @map("created_by_id")
  createdBy      User           @relation("ForkliftCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  shifts          Shift[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]

  @@index([status, isActive])
  @@map("forklifts")
}

model Shift {
  id                String        @id @default(uuid())
  forkliftId        String        @map("forklift_id")
  forklift          Forklift      @relation(fields: [forkliftId], references: [id])
  createdById       String        @map("created_by_id")
  createdBy         User          @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  endedById         String?       @map("ended_by_id")
  endedBy           User?         @relation("ShiftEndedBy", fields: [endedById], references: [id])
  endType           ShiftEndType? @map("end_type")
  startTime         DateTime      @map("start_time")
  endTime           DateTime?     @map("end_time")
  status            ShiftStatus   @default(ACTIVE)
  startingReading   Decimal       @db.Decimal(10, 1) @map("starting_reading")
  endingReading     Decimal?      @db.Decimal(10, 1) @map("ending_reading")
  totalHoursWorked  Decimal?      @db.Decimal(6, 2) @map("total_hours_worked")
  totalReadingDelta Decimal?      @db.Decimal(10, 1) @map("total_reading_delta")
  notes             String?
  isDeleted         Boolean       @default(false) @map("is_deleted")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  fuelLogs FuelLog[]

  @@index([forkliftId, status])
  @@index([startTime])
  @@index([isDeleted, status])
  @@index([endTime])
  @@map("shifts")
}

model FuelLog {
  id               String   @id @default(uuid())
  forkliftId       String   @map("forklift_id")
  forklift         Forklift @relation(fields: [forkliftId], references: [id])
  createdById      String   @map("created_by_id")
  createdBy        User     @relation("FuelLogCreatedBy", fields: [createdById], references: [id])
  shiftId          String?  @map("shift_id")
  shift            Shift?   @relation(fields: [shiftId], references: [id])
  fuelAmountLiters Decimal  @db.Decimal(8, 2) @map("fuel_amount_liters")
  fuelCostZar      Decimal? @db.Decimal(10, 2) @map("fuel_cost_zar")
  readingAtRefuel  Decimal  @db.Decimal(10, 1) @map("reading_at_refuel")
  refuelDateTime   DateTime @default(now()) @map("refuel_date_time")
  notes            String?
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([forkliftId])
  @@index([refuelDateTime])
  @@index([isDeleted, refuelDateTime])
  @@map("fuel_logs")
}

model MaintenanceLog {
  id          String            @id @default(uuid())
  forkliftId  String            @map("forklift_id")
  forklift    Forklift          @relation(fields: [forkliftId], references: [id])
  date        DateTime          @db.Date
  description String
  costZar     Decimal?          @db.Decimal(10, 2) @map("cost_zar")
  createdById String            @map("created_by_id")
  createdBy   User              @relation("MaintenanceLogCreatedBy", fields: [createdById], references: [id])
  status      MaintenanceStatus @default(SCHEDULED)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([forkliftId, status])
  @@index([date])
  @@map("maintenance_logs")
}
